[Unit]
Description=USBeam - USB over IP (shares and connects USB devices)
Documentation=https://github.com/EliSantana1/USBeam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/usbeam --service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
