// USBeam: let administrators start, stop and restart the USBeam service from the USBeam
// app (Quit, Restart) without a password prompt. Applies to usbeam.service only.
// Administrators are in "wheel" (Arch, Fedora, openSUSE...), "sudo" (Debian, Ubuntu, Mint...) or "admin".
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "usbeam.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop" || action.lookup("verb") == "restart") &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo") || subject.isInGroup("admin")) &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
